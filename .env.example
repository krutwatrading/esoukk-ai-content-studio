# Shopify Dev Dashboard app — keep actual values only in .env.local / Vercel
SHOPIFY_SHOP=12dafb
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# Used to verify Shopify webhook signatures. This is the same app client secret.
SHOPIFY_API_VERSION=2026-07

# Optional paid AI features
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-5-mini
OPENAI_IMAGE_MODEL=gpt-image-1
# Runway Dev API key for 25-second WAN 3.0 ads
RUNWAYML_API_SECRET=

ALLOWED_SHOPIFY_DOMAINS=esoukk.ae,www.esoukk.ae,shopkavia.com,www.shopkavia.com

# Supabase (prefer current publishable/secret keys)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
NEXT_PUBLIC_SITE_URL=https://ai.esoukk.ae

# Resend email delivery (Phase 11.3)
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
RESEND_FROM_EMAIL=KAVIA <hello@updates.shopkavia.com>
RESEND_KAVIA_FROM_EMAIL=KAVIA <hello@updates.shopkavia.com>
RESEND_KAVIA_REPLY_TO=support@shopkavia.com
RESEND_ESOUKK_FROM_EMAIL=eSoukk <hello@updates.esoukk.ae>
RESEND_ESOUKK_REPLY_TO=support@esoukk.ae
EMAIL_BULK_SEND_ENABLED=false
EMAIL_UNSUBSCRIBE_SECRET=
EMAIL_LIVE_AUDIENCE_MODE=test
EMAIL_LIVE_TEST_RECIPIENTS=
EMAIL_LIVE_RECIPIENT_LIMIT=5
NEXT_PUBLIC_APP_URL=https://ai.esoukk.ae

# Meta publishing (Phase 4)
META_APP_ID=
META_APP_SECRET=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# Generate at least 32 random bytes; used server-side to encrypt social tokens.
SOCIAL_TOKEN_ENCRYPTION_KEY=
CRON_SECRET=
META_GRAPH_API_VERSION=v25.0
